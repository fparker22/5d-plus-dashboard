# Example .env file for 5D+ Teacher Evaluation Automation
# Copy this to .env and fill in your actual values

# LLM Mode: hybrid (recommended), cloud, or ollama
LLM_MODE=hybrid

# Anthropic API Key (for Claude 3.5 Sonnet)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Output directory for generated evaluation documents
# Use absolute path or ~ for home directory
OUTPUT_DIR=~/Desktop/Teacher_Evals

# Optional: Google Docs API credentials path
# GOOGLE_APPLICATION_CREDENTIALS=~/.gemini/antigravity/credentials.json

# Optional: Ollama settings (if using local LLM mode)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3:70b

# ── Grace Graduation SMS Reminders ───────────────────────────────────────────
# Twilio credentials — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567   # Your Twilio phone number in E.164 format

# Netlify — https://app.netlify.com/user/applications (Personal access tokens)
NETLIFY_TOKEN=your_netlify_personal_access_token
NETLIFY_SITE_ID=graceparker.life  # Site name or ID from Netlify dashboard
NETLIFY_FORM_NAME=grace-rsvp      # Must match data-netlify name attr in HTML
