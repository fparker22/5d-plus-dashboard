# Follow-Up Machine — environment settings.
# Copy to .env.local and fill in what you have. With everything blank the app
# runs on built-in demo data and sends nothing.

# ── Safety switch ────────────────────────────────────────────────────────────
# Messages are only delivered to real people when this is exactly "live".
# Anything else logs each message as "test mode".
SEND_MODE=

# ── Access ───────────────────────────────────────────────────────────────────
# Shared password for the dashboard. Leave blank only for a local demo.
APP_PASSWORD=
# The public address of this deployment, e.g. https://app.youragency.com
PUBLIC_BASE_URL=
# Your own scheduling link, used by the buttons on the sales page.
AGENCY_BOOKING_URL=

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Run supabase/schema.sql first. Use the service-role key; keep it server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Texting and calls (Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: an A2P 10DLC Messaging Service. When set, texts go through it.
TWILIO_MESSAGING_SERVICE_SID=
# Fallback sending number if a business has none in its settings.
TWILIO_FROM_NUMBER=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=

# ── AI (Claude) ──────────────────────────────────────────────────────────────
# Powers lead scoring, two-way replies, review replies and content planning.
# Without it the agents fall back to simple built-in rules.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. For high-volume texting you can choose
# a faster, cheaper model here, such as claude-haiku-5-5.
ANTHROPIC_MODEL=

# ── Phone attendant (ElevenLabs) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=
# The ElevenLabs phone number used for outbound agent calls.
ELEVENLABS_PHONE_NUMBER_ID=
# Signing secret of the post-call webhook, to verify call reports.
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret the voice agent sends when it calls /api/agent-tools.
AGENT_TOOLS_SECRET=

# ── Social scheduling (Metricool) ────────────────────────────────────────────
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=

# ── Machine access ───────────────────────────────────────────────────────────
# Sent by the scheduler that calls /api/cron/tick every 5 minutes.
CRON_SECRET=
# Sent by execution/provision_followup_client.py to create client businesses.
AGENCY_API_KEY=
